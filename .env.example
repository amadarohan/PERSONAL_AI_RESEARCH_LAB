# Environment configuration template.
# Copy to `.env` (git-ignored) or set these as real environment variables.
# ASP.NET Core maps double-underscore to configuration section separators.

# --- Database ---------------------------------------------------------------
# Integrated security (Windows auth) against a local default instance.
ConnectionStrings__Default=Server=localhost;Database=PersonalResearchLab;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=True

# SQL authentication alternative. Do not commit a real password.
# ConnectionStrings__Default=Server=localhost;Database=PersonalResearchLab;User Id=YOUR_DB_USER;Password=YOUR_DB_PASSWORD;TrustServerCertificate=True;MultipleActiveResultSets=True

# --- File storage -----------------------------------------------------------
# Relative paths resolve against the content root.
Storage__RootPath=storage/files
Storage__MaxFileSizeBytes=104857600

# --- Secret store -----------------------------------------------------------
# DPAPI-protected container. On Windows the file is encrypted for the current user.
# On other platforms it is written as plaintext and a warning is logged.
Secrets__FilePath=storage/secrets/secrets.bin

# --- Hosting ----------------------------------------------------------------
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://localhost:5103

# --- AI provider keys -------------------------------------------------------
# Do NOT put provider keys here. Keys are entered in the Settings page and stored
# through ISecretStore (DPAPI on Windows). The database only keeps the secret name.
# This placeholder exists to make the rule explicit:
# OPENAI_API_KEY=YOUR_API_KEY
