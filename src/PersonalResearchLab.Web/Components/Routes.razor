<Router AppAssembly="typeof(Program).Assembly">
    <Found Context="routeData">
        <RouteView RouteData="routeData" DefaultLayout="typeof(Layout.MainLayout)" />
        <FocusOnNavigate RouteData="routeData" Selector="h1" />
    </Found>
    <NotFound>
        <LayoutView Layout="typeof(Layout.MainLayout)">
            <div class="empty-state card" style="margin-top: var(--space-8);">
                <div class="empty-icon">◌</div>
                <div class="empty-title">این صفحه وجود ندارد</div>
                <div class="empty-text">
                    نشانی درخواستی با هیچ صفحه‌ای در رصدخانه دانش مطابقت ندارد.
                    از نوار کناری یکی از بخش‌ها را انتخاب کنید.
                </div>
                <div style="margin-top: var(--space-4);">
                    <a class="btn btn-primary" href="/">بازگشت به مرکز فرمان</a>
                </div>
            </div>
        </LayoutView>
    </NotFound>
</Router>
