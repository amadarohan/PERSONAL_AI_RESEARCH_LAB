<?xml version="1.0" encoding="utf-8"?>
<!--
  Repository-local NuGet configuration.

  The machine-wide configuration registers private Nexus feeds
  (nexus3.dotin.ir) that return HTTP 401 for this project and therefore
  break restore. This file clears inherited sources and pins restore to
  the public nuget.org feed so the solution builds reproducibly on any
  machine without corporate credentials.

  If you need the private feeds for other work, do not edit this file;
  use a separate solution or pass an explicit config file to restore.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
